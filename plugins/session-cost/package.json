{
  "name": "@local/session-cost",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Session cost tracking for DeepSeek Harness: live USD badge, per-task and per-request breakdowns, and OpenCode Go quota windows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoNgo232/dsh-plugins.git",
    "directory": "plugins/session-cost"
  },
  "homepage": "https://github.com/HaoNgo232/dsh-plugins/tree/main/plugins/session-cost",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cost",
    "usage",
    "opencode-go"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "pricing.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
