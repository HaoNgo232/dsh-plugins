{
  "name": "@local/agy-dispatch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dispatch tasks to the Antigravity agy CLI from DSH agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoNgo232/dsh-plugins.git",
    "directory": "plugins/agy-dispatch"
  },
