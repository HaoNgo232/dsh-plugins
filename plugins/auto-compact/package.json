{
  "name": "@local/auto-compact",
  "version": "1.1.0",
  "private": true,
  "description": "Absolute-token auto compaction trigger for DeepSeek Harness sessions, with a Settings page",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaoNgo232/dsh-plugins.git",
    "directory": "plugins/auto-compact"
  },
  "homepage": "https://github.com/HaoNgo232/dsh-plugins/tree/main/plugins/auto-compact",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "compaction",
    "context",
    "settings"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
